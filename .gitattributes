# Устанавливаем перевод строк по умолчанию
* text=auto eol=lf

# Явно указываем для некоторых типов файлов
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf

# Бинарные файлы не трогаем
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
